# Provider: gemini | openai | anthropic
# Defaults to Gemini when omitted. Xonus.fromEnv() also auto-detects from keys.
# XONUS_PROVIDER=gemini

# Gemini (Google AI Studio)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI or any OpenAI-compatible gateway
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Optional: provider-agnostic overrides
# XONUS_API_KEY=
# XONUS_MODEL=
# XONUS_BASE_URL=

# Set to 1 to run the optional live smoke test (makes one real model request)
# XONUS_LIVE_TEST=1
