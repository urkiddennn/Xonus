---
import GitHubIcon from './GitHubIcon.astro';
import HeartIcon from './HeartIcon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <img class="brand-mark" src="/assets/logo.svg" alt="" width="30" height="30" />
          Xonus
        </a>
        <p>
          A model-agnostic decision engine with log-odds early stopping and an answer-mass
          quality gate. Gemini, OpenAI, Anthropic, or your own adapter — one contract.
        </p>
      </div>

      <div class="footer-col">
        <h4>Product</h4>
        <ul>
          <li><a href="/#features">Features</a></li>
          <li><a href="/#how">How it works</a></li>
          <li><a href="/#benchmark">Benchmark</a></li>
          <li><a href="/#gate">Quality gate</a></li>
          <li><a href="/#faq">FAQ</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Developers</h4>
        <ul>
          <li><a href="/docs#installation">Installation</a></li>
          <li><a href="/docs#quickstart">Quickstart</a></li>
          <li><a href="/docs#decide">API reference</a></li>
          <li><a href="/docs#tuning">Tuning</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Resources</h4>
        <ul>
          <li>
            <a
              class="with-icon"
              href={site.repo}
              target="_blank"
              rel="noreferrer"
            >
              <GitHubIcon size={13} /> Contribute on GitHub ↗
            </a>
          </li>
          <li>
            <a
              class="with-icon donate"
              href={site.sponsor}
              target="_blank"
              rel="noreferrer"
            >
              <HeartIcon size={13} /> Sponsor / donate ↗
            </a>
          </li>
          <li>
            <a href={site.npm} target="_blank" rel="noreferrer">
              npm package ↗
            </a>
          </li>
          <li><a href="/docs#providers">Provider guide</a></li>
          <li><a href="/docs#benchmark">Benchmark</a></li>
          <li><a href="/docs#publishing">Publishing</a></li>
          <li><a href="/docs#license">License</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Xonus · v0.1.0</span>
      <span class="license">MIT licensed · made for decisions that matter</span>
    </div>
  </div>
</footer>
