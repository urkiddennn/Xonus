                    <td>Number of model passes used.</td>
                  </tr>
                  <tr>
                    <td>source</td>
                    <td><code>'fast' | 'deliberate' | 'text'</code></td>
                    <td>Where the final evidence came from.</td>
                  </tr>
                  <tr>
                    <td>provider</td>
                    <td><code>string</code></td>
                    <td>Provider identifier, such as <code>gemini</code> or <code>openai</code>.</td>
                  </tr>
                  <tr>
                    <td>model</td>
                    <td><code>string</code></td>
                    <td>Configured model name.</td>
                  </tr>
                  <tr>
                    <td>latencyMs</td>
                    <td><code>number</code></td>
                    <td>Wall-clock latency for the decision.</td>
                  </tr>
                  <tr>
                    <td>rationale</td>
                    <td><code>string?</code></td>
                    <td>Short justification from a deliberation pass, when available.</td>
                  </tr>
                  <tr>
                    <td>notes</td>
                    <td><code>string[]</code></td>
                    <td>Non-fatal diagnostics such as <code>deliberate_unparsed</code>.</td>
