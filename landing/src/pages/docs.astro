                    </td>
                  </tr>
                  <tr>
                    <td>signal</td>
                    <td><code>AbortSignal</code></td>
                    <td>Optional cancellation signal for this decision.</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <h3>DecisionResponse</h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Field</th>
                    <th>Type</th>
                    <th>Description</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>decision</td>
                    <td><code>string</code></td>
                    <td>The chosen option, verbatim from the input.</td>
                  </tr>
                  <tr>
                    <td>probabilities</td>
                    <td><code>Record&lt;string, number&gt;</code></td>
                    <td>
                      Normalized probability per option, keyed by option text. Sums to 1
                      when evidence exists; empty on text-only fallback.
                    </td>
                  </tr>
                  <tr>
                    <td>confidence</td>
                    <td><code>number</code></td>
                    <td>Probability assigned to the chosen option. <code>0</code> in text fallback.</td>
                  </tr>
                  <tr>
                    <td>logOdds</td>
                    <td><code>number</code></td>
                    <td>
                      Margin between the top two options, capped at
                      <code>99</code> so results stay JSON-safe.
                    </td>
                  </tr>
                  <tr>
                    <td>answerMass</td>
                    <td><code>number</code></td>
                    <td>Raw mass on valid option tokens, 0–1.</td>
                  </tr>
                  <tr>
                    <td>gatePassed</td>
                    <td><code>boolean</code></td>
                    <td><code>answerMass &gt;= answerMassGate</code>.</td>
                  </tr>
                  <tr>
                    <td>decisive</td>
                    <td><code>boolean</code></td>
                    <td><code>logOdds &gt;= tau</code>.</td>
                  </tr>
                  <tr>
                    <td>confident</td>
                    <td><code>boolean</code></td>
                    <td><code>gatePassed &amp;&amp; decisive</code>.</td>
                  </tr>
                  <tr>
                    <td>optionIndex</td>
                    <td><code>number</code></td>
                    <td>Zero-based index of the chosen option.</td>
                  </tr>
                  <tr>
                    <td>escalated</td>
                    <td><code>boolean</code></td>
                    <td>Whether a deliberation pass ran.</td>
                  </tr>
                  <tr>
                    <td>earlyStopped</td>
                    <td><code>boolean</code></td>
                    <td>
                      Whether the decision was accepted in the fast pass, or the
                      deliberation stream was aborted at a decisive answer.
                    </td>
